# --- Google Sheet ---
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# --- Service account (Sheets access) ---
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json

# --- Gmail OAuth (sending + reply checking) ---
# Create these in Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Application type: Desktop app.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SENDER_EMAIL=pruthvik.fit@gmail.com
GMAIL_TOKEN_FILE=./credentials/gmail-token.json

# --- Safety controls ---
DRY_RUN=true
# For a brand-new sending mailbox, don't start at full volume — warm it up:
# ~20/day for week 1, then raise gradually (see README) only once bounce rate
# stays low, replies are coming in, and a self-send test lands in Inbox.
DAILY_SEND_LIMIT=100
# Random human-like pause between each send, so emails don't fire in a burst.
SEND_DELAY_MIN_SECONDS=45
SEND_DELAY_MAX_SECONDS=120
FOLLOWUP_1_BUSINESS_DAYS=3
FOLLOWUP_2_BUSINESS_DAYS=5

# --- Sender identity used in email templates ---
SENDER_NAME=EduMatrix Academic Solutions
SENDER_PHONE=+91 8830241857
